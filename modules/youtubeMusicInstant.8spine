/* @8spine-meta
 * type: MODULE
 * category: modules
 * featured: false
 * trusted: false
 * nsfw: false
 */

// ============================================================================
//  YouTube Music — INSTANT  •  8SPINE Module
// ----------------------------------------------------------------------------
//  Goal: real tap-to-play instant playback that ACTUALLY plays in 8SPINE.
//
//  Key lessons baked in:
//   * 8SPINE's native player needs a self-contained PROGRESSIVE mp4 (itag 18)
//     or HLS — a raw adaptive audio-only segment (itag 140) will NOT play.
//     So streaming serves progressive itag 18 (fast: ~180ms TTFB, un-throttled).
//   * The return MUST include a top-level `mimeType` so the player knows how to
//     decode the stream.
//   * Single lean ANDROID /player call — no visitorData round-trip (that's the
//     ~1s stall other modules hit on cold play). IOS audio is a safety fallback.
//   * Downloads grab the smaller audio-only m4a (itag 140) to save space.
//   * googlevideo URLs live ~6h, so prefetch is safe -> next track is instant.
// ============================================================================

const LOG = '[YTM-Instant]';
const KEY = 'AIzaSyC9XL3ZjWddXya6X74dJoCTL-WEYFDNX30';

const SEARCH_CLIENT = {
  name: 'IOS_MUSIC', id: '26', version: '7.27.0',
  ua: 'com.google.ios.youtubemusic/7.27.0 (iPhone16,2; U; CPU iOS 18_3_2 like Mac OS X)',
  host: 'https://music.youtube.com',
};
const WEB_CLIENT = {
  name: 'WEB_REMIX', id: '67', version: '1.20260304.03.00',
  ua: 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36',
  host: 'https://music.youtube.com',
};
const ANDROID_CLIENT = {
  name: 'ANDROID', id: '3', version: '20.22.36',
  ua: 'com.google.android.youtube/20.22.36 (Linux; U; Android 15)',
  host: 'https://music.youtube.com',
};
const IOS_CLIENT = {
  name: 'IOS', id: '5', version: '20.22.1',
  ua: 'com.google.ios.youtube/20.22.1 (iPhone16,2; U; CPU iOS 18_5 like Mac OS X)',
  host: 'https://music.youtube.com',
};
// Player order: ANDROID first (gives progressive itag 18 that the player accepts),
// IOS as a fallback (audio-only) so resolve never dies on one client.
const PLAYER_CLIENTS = [ANDROID_CLIENT, IOS_CLIENT];
const SONGS_FILTER = 'EgWKAQIIAWoKEAkQBRAKEAMQBA%3D%3D';
const MEDIA_CACHE_TTL_MS = 4 * 60 * 60 * 1000;
const MEDIA_CACHE_SAFETY_MS = 30 * 1000;
const PREFETCH_LIMIT = 3;
const mediaCache = {};
const mediaInflight = {};
let lastTrackList = [];

const QUALITY = { LOW: 'LOW', HIGH: 'HIGH', LOSSLESS: 'LOSSLESS' };
const QUALITY_OPTIONS = [
  { label: 'Low (saves data)', value: QUALITY.LOW },
  { label: 'High', value: QUALITY.HIGH },
  { label: 'Best Available', value: QUALITY.LOSSLESS },
];

// ---------------------------------------------------------------------------
function buildContext(c) {
  const client = { clientName: c.name, clientVersion: c.version, userAgent: c.ua, hl: 'en', gl: 'US' };
  if (c.name === 'ANDROID') {
    client.androidSdkVersion = 35; client.osName = 'Android'; client.osVersion = '15';
  } else if (c.name === 'IOS' || c.name === 'IOS_MUSIC') {
    client.deviceMake = 'Apple'; client.deviceModel = 'iPhone16,2';
    client.osName = 'iPhone'; client.osVersion = c.name === 'IOS' ? '18.5.0.22F76' : '18.3.2.22D82';
  }
  // WEB_REMIX intentionally carries only the web client context. Adding a
  // mobile device to it makes album browse responses inconsistent.
  return { client: client };
}

async function innertube(client, endpoint, payload) {
  const res = await fetch(client.host + '/youtubei/v1/' + endpoint + '?prettyPrint=false&key=' + KEY, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'User-Agent': client.ua,
      'X-YouTube-Client-Name': client.id,
      'X-YouTube-Client-Version': client.version,
    },
    body: JSON.stringify(Object.assign({ context: buildContext(client) }, payload)),
  });
  if (!res.ok) throw new Error(LOG + ' ' + endpoint + ' HTTP ' + res.status);
  return res.json();
}

function collect(node, key, out) {
  out = out || [];
  if (Array.isArray(node)) { for (let i = 0; i < node.length; i++) collect(node[i], key, out); }
  else if (node && typeof node === 'object') {
    const ks = Object.keys(node);
    for (let i = 0; i < ks.length; i++) { if (ks[i] === key) out.push(node[ks[i]]); collect(node[ks[i]], key, out); }
  }
  return out;
}
function firstVideoId(n) {
  if (!n || typeof n !== 'object') return null;
  if (typeof n.videoId === 'string' && n.videoId.length === 11) return n.videoId;
  const ks = Object.keys(n);
  for (let i = 0; i < ks.length; i++) { const r = firstVideoId(n[ks[i]]); if (r) return r; }
  return null;
}
function runsToText(r) { if (!Array.isArray(r)) return ''; let s = ''; for (let i = 0; i < r.length; i++) s += (r[i] && r[i].text) || ''; return s; }
function parseDuration(s) { if (!/^\d+(:\d{1,2})+$/.test(s || '')) return 0; return s.split(':').reduce(function (a, p) { return a * 60 + parseInt(p, 10); }, 0); }
function upscaleThumb(u) { return typeof u === 'string' ? u.replace(/=w\d+-h\d+/, '=w544-h544') : u; }
function expireFromUrl(u) { const m = /[?&]expire=(\d+)/.exec(u || ''); return m ? parseInt(m[1], 10) * 1000 : 0; }

function decodeParam(value) {
  try { return decodeURIComponent(String(value || '')); }
  catch (e) { return String(value || ''); }
}

function cipherParam(cipher, name) {
  const match = new RegExp('(?:^|&)' + name + '=([^&]*)').exec(String(cipher || ''));
  return match ? decodeParam(match[1]) : '';
}

function directFormatUrl(format) {
  if (format && format.url) return format.url;
  const cipher = format && (format.signatureCipher || format.cipher);
  if (!cipher) return '';

  const url = cipherParam(cipher, 'url');
  const signature = cipherParam(cipher, 'sig') || cipherParam(cipher, 'signature');
  if (!url || !signature) return '';

  const separator = url.indexOf('?') >= 0 ? '&' : '?';
  const parameter = cipherParam(cipher, 'sp') || 'signature';
  return url + separator + parameter + '=' + encodeURIComponent(signature);
}

function normalizeSearchQuery(query) {
  const raw = String(query || '');
  try {
    return decodeURIComponent(raw);
  } catch (e) {
    return raw;
  }
}

function browseIdFromRun(run) {
  return run?.navigationEndpoint?.browseEndpoint?.browseId || '';
}

function subtitleMetadata(runs) {
  const text = runsToText(runs);
  const parts = text.split(/\s*[•·]\s*/).map(function (part) { return part.trim(); }).filter(Boolean);
  let duration = 0;
  const remaining = [];
  for (let i = 0; i < parts.length; i++) {
    const parsed = parseDuration(parts[i]);
    if (parsed && !duration) duration = parsed;
    else if (!/^Song$|^Video$|^EP$|^Single$|^Podcast$/i.test(parts[i])) remaining.push(parts[i]);
  }
  const browseIds = (runs || []).map(function (run) { return browseIdFromRun(run); }).filter(Boolean);
  return {
    artist: remaining[0] || '',
    album: remaining[1] || '',
    duration: duration,
    artistId: browseIds[0] || '',
    albumId: browseIds[1] || '',
  };
}

function rendererTitle(renderer) {
  return runsToText(renderer?.title?.runs) ||
    runsToText(renderer?.flexColumns?.[0]?.musicResponsiveListItemFlexColumnRenderer?.text?.runs) || '';
}

function rendererSubtitleRuns(renderer) {
  return renderer?.subtitle?.runs ||
    renderer?.flexColumns?.[1]?.musicResponsiveListItemFlexColumnRenderer?.text?.runs || [];
}

function rendererVideoId(renderer) {
  return renderer?.navigationEndpoint?.watchEndpoint?.videoId ||
    renderer?.playlistItemData?.videoId || firstVideoId(renderer);
}

function rendererCover(renderer, fallback) {
  const thumbs = renderer?.thumbnail?.musicThumbnailRenderer?.thumbnail?.thumbnails || [];
  if (!thumbs.length) return fallback || '';
  return upscaleThumb(thumbs[thumbs.length - 1].url) || fallback || '';
}

function mapTrackRenderer(renderer, fallback) {
  const subtitleRuns = rendererSubtitleRuns(renderer);
  const meta = subtitleMetadata(subtitleRuns);
  const fixedDuration = renderer?.fixedColumns?.[0]?.musicResponsiveListItemFixedColumnRenderer?.text?.runs?.[0]?.text || '';
  const videoId = rendererVideoId(renderer);
  if (!videoId) return null;
  return {
    id: videoId,
    title: rendererTitle(renderer).trim(),
    artist: meta.artist || fallback?.artist || 'Unknown Artist',
    artistId: meta.artistId || fallback?.artistId,
    album: meta.album || fallback?.album || '',
    albumId: meta.albumId || fallback?.albumId,
    duration: meta.duration || parseDuration(fixedDuration),
    albumCover: rendererCover(renderer, fallback?.albumCover),
  };
}

function mapSearchRows(data, limit) {
  const rows = collect(data, 'musicTwoColumnItemRenderer')
    .concat(collect(data, 'musicResponsiveListItemRenderer'));
  const tracks = [];
  const seen = {};
  for (let i = 0; i < rows.length && tracks.length < limit; i++) {
    const track = mapTrackRenderer(rows[i]);
    if (!track || seen[track.id]) continue;
    seen[track.id] = true;
    tracks.push(track);
  }
  return tracks;
}

function mergeTrackLists(lists, limit) {
  const tracks = [];
  const seen = {};
  for (let li = 0; li < lists.length && tracks.length < limit; li++) {
    const list = lists[li] || [];
    for (let i = 0; i < list.length && tracks.length < limit; i++) {
      const track = list[i];
      if (!track || !track.id || seen[track.id]) continue;
      seen[track.id] = true;
      tracks.push(track);
    }
  }
  return tracks;
}

function contextTrackIds(context) {
  const ids = [];
  const add = function (value) {
    if (Array.isArray(value)) {
      for (let i = 0; i < value.length; i++) add(value[i]);
    } else if (typeof value === 'string' && value && ids.indexOf(value) < 0) {
      ids.push(value);
    } else if (value && typeof value === 'object') {
      add(value.id || value.videoId || value.trackId || value.youtubeId);
    }
  };
  const source = context || {};
  add(source.nextTrackId);
  add(source.nextTrackIds);
  add(source.nextTracks);
  add(source.queueTracks);
  add(source.queue);
  return ids;
}

function cacheKey(trackId, quality, forDownload) {
  return (forDownload ? 'download:' : 'playback:') + String(trackId) + ':' + String(quality || QUALITY.HIGH);
}

function cachedMedia(key) {
  const entry = mediaCache[key];
  if (!entry) return null;
  if (entry.expiresAt > Date.now() + MEDIA_CACHE_SAFETY_MS) return entry.media;
  delete mediaCache[key];
  return null;
}

function resolveCachedMedia(trackId, quality, forDownload) {
  const key = cacheKey(trackId, quality, forDownload);
  const cached = cachedMedia(key);
  if (cached) return Promise.resolve(cached);
  if (mediaInflight[key]) return mediaInflight[key];
  mediaInflight[key] = resolveMediaUncached(trackId, quality, forDownload)
    .then(function (media) {
      mediaCache[key] = {
        media: media,
        expiresAt: media.expiresAt || (Date.now() + MEDIA_CACHE_TTL_MS),
      };
      return media;
    })
    .finally(function () { delete mediaInflight[key]; });
  return mediaInflight[key];
}

function prefetchTracks(tracks, quality) {
  const items = (tracks || []).slice(0, PREFETCH_LIMIT);
  for (let i = 0; i < items.length; i++) {
    if (!items[i]?.id) continue;
    resolveCachedMedia(items[i].id, quality || QUALITY.HIGH, false).catch(function (error) {
      console.log(LOG, 'Prefetch failed for', items[i].id, error.message);
    });
  }
}

function prefetchFollowing(trackId, quality, context) {
  const explicitIds = contextTrackIds(context);
  if (explicitIds.length) {
    prefetchTracks(explicitIds.map(function (id) { return { id: id }; }), quality);
    return;
  }
  const index = lastTrackList.findIndex(function (track) { return String(track.id) === String(trackId); });
  if (index >= 0) prefetchTracks(lastTrackList.slice(index + 1), quality);
}

// --------------------------------------------------------------- searchTracks
async function searchTracks(query, limit) {
  const max = limit || 25;
  const normalized = normalizeSearchQuery(query);
  // Keep the song-filtered result first, then merge a general web result. The
  // latter is important for emoji-titled art tracks and album-linked results
  // that YouTube does not expose in the filtered shelf.
  const responses = await Promise.all([
    innertube(SEARCH_CLIENT, 'search', { query: normalized, params: SONGS_FILTER }).catch(function () { return null; }),
    innertube(WEB_CLIENT, 'search', { query: normalized, params: SONGS_FILTER }).catch(function () { return null; }),
    innertube(WEB_CLIENT, 'search', { query: normalized }).catch(function () { return null; }),
  ]);
  const lists = [];
  for (let i = 0; i < responses.length; i++) {
    if (responses[i]) lists.push(mapSearchRows(responses[i], max));
  }
  const tracks = mergeTrackLists(lists, max);
  // Keep the result list for queue-aware prefetch. Do not resolve speculative
  // media while search is returning; that adds contention to first playback.
  lastTrackList = tracks;
  return { tracks: tracks, total: tracks.length };
}

// --------------------------------------------------------------- resolve
// Returns { url, mimeType, bitrate, contentLength, durationMs } for the chosen
// format. `forDownload` flips preference to audio-only (smaller).
async function resolveMediaUncached(trackId, quality, forDownload) {
  if (!trackId) throw new Error(LOG + ' Missing trackId');
  let lastErr = null;

  for (let ci = 0; ci < PLAYER_CLIENTS.length; ci++) {
    try {
      const data = await innertube(PLAYER_CLIENTS[ci], 'player', {
        videoId: String(trackId), contentCheckOk: true, racyCheckOk: true,
      });
      const ps = (data.playabilityStatus && data.playabilityStatus.status) || 'UNKNOWN';
      if (ps !== 'OK') { lastErr = new Error(LOG + ' ' + PLAYER_CLIENTS[ci].name + ': ' + ((data.playabilityStatus && data.playabilityStatus.reason) || ps)); continue; }

      const sd = data.streamingData || {};
      const progressive = (sd.formats || [])
        .filter(function (f) {
          const mime = f.mimeType || '';
          return directFormatUrl(f) && mime.indexOf('video/mp4') === 0 && mime.indexOf('mp4a') >= 0;
        });
      const progressiveFallback = (sd.formats || [])
        .filter(function (f) { return directFormatUrl(f) && (f.mimeType || '').indexOf('video/mp4') === 0; });
      const audio = (sd.adaptiveFormats || [])
        .filter(function (f) { return directFormatUrl(f) && (f.mimeType || '').indexOf('audio/') === 0; })
        .sort(function (a, b) { return (a.bitrate || 0) - (b.bitrate || 0); });
      const audioMp4 = audio.filter(function (f) { return (f.mimeType || '').indexOf('audio/mp4') === 0; });

      let pick = null;
      if (forDownload) {
        // smaller audio-only m4a preferred for downloads
        const preferredAudio = audioMp4.length ? audioMp4 : audio;
        if (preferredAudio.length) pick = String(quality).toUpperCase() === QUALITY.LOW ? preferredAudio[0] : preferredAudio[preferredAudio.length - 1];
        else if (progressive.length) pick = progressive[0];
        else if (progressiveFallback.length) pick = progressiveFallback[0];
      } else {
        // STREAMING: progressive itag 18 plays reliably & starts fast
        if (progressive.length) pick = progressive[0];
        else if (progressiveFallback.length) pick = progressiveFallback[0];
        else if (sd.hlsManifestUrl) {
          return {
            url: sd.hlsManifestUrl,
            mimeType: 'application/vnd.apple.mpegurl',
            isHls: true,
            bitrate: 0,
            contentLength: undefined,
            durationMs: undefined,
            expiresAt: expireFromUrl(sd.hlsManifestUrl) || undefined,
          };
        } else if (audio.length) {
          const preferredAudio = audioMp4.length ? audioMp4 : audio;
          pick = String(quality).toUpperCase() === QUALITY.LOW ? preferredAudio[0] : preferredAudio[preferredAudio.length - 1];
        }
      }
      const pickedUrl = directFormatUrl(pick);
      if (pick && pickedUrl) {
        return {
          url: pickedUrl,
          mimeType: pick.mimeType || (forDownload ? 'audio/mp4' : 'video/mp4'),
          isHls: false,
          bitrate: pick.bitrate || 0,
          contentLength: pick.contentLength ? parseInt(pick.contentLength, 10) : undefined,
          durationMs: pick.approxDurationMs ? parseInt(pick.approxDurationMs, 10) : undefined,
          expiresAt: expireFromUrl(pickedUrl) || undefined,
        };
      }
      lastErr = new Error(LOG + ' ' + PLAYER_CLIENTS[ci].name + ': no usable format');
    } catch (e) { lastErr = e; }
  }
  throw (lastErr || new Error(LOG + ' Could not resolve stream'));
}

async function getTrackStreamUrl(trackId, preferredQuality, context) {
  const quality = (context && context.settings && context.settings.quality && context.settings.quality.value) || preferredQuality || QUALITY.HIGH;
  const m = await resolveCachedMedia(trackId, quality, false);
  prefetchFollowing(trackId, quality, context);
  return {
    streamUrl: m.url,
    streamType: m.isHls ? 'hls' : 'direct',
    mimeType: m.mimeType,          // top-level so the player configures decode
    contentLength: m.contentLength,
    expiresAt: m.expiresAt,
    track: { id: String(trackId), audioQuality: quality, bitrate: m.bitrate, mimeType: m.mimeType, durationMs: m.durationMs },
  };
}

async function getTrackDownloadUrl(trackId, preferredQuality, context) {
  const quality = (context && context.settings && context.settings.quality && context.settings.quality.value) || preferredQuality || QUALITY.LOSSLESS;
  const m = await resolveCachedMedia(trackId, quality, true);
  const isAudio = (m.mimeType || '').indexOf('audio/') === 0;
  const isMp4Audio = (m.mimeType || '').indexOf('audio/mp4') === 0;
  return {
    downloadUrl: m.url,
    streamUrl: m.url,
    mimeType: m.mimeType,
    fileName: String(trackId) + (isMp4Audio ? '.m4a' : isAudio ? '.webm' : '.mp4'),
    track: { id: String(trackId), audioQuality: quality, bitrate: m.bitrate },
  };
}

function albumHeader(data, albumId) {
  const header = data?.header?.musicDetailHeaderRenderer ||
    data?.header?.musicImmersiveHeaderRenderer ||
    collect(data, 'musicDetailHeaderRenderer')[0] ||
    collect(data, 'musicImmersiveHeaderRenderer')[0] || {};
  const microTitle = data?.microformat?.microformatDataRenderer?.title || '';
  const headerTitle = runsToText(header?.title?.runs).trim();
  const rawTitle = headerTitle || microTitle;
  const byMatch = /^(.*?)\s+-\s+(?:Full Moon Edition|Album|Single|EP)\s+by\s+(.+)$/i.exec(rawTitle);
  const title = (byMatch ? byMatch[1] : rawTitle).trim() || String(albumId);
  const headerMeta = subtitleMetadata(header?.subtitle?.runs || []);
  return {
    title: title,
    artist: byMatch ? byMatch[2].trim() : (headerMeta.artist || 'Unknown Artist'),
    artistId: headerMeta.artistId,
    albumCover: rendererCover(header, '') || rendererCover(data?.background, ''),
  };
}

function albumRows(data) {
  const shelves = collect(data, 'musicShelfRenderer');
  for (let i = 0; i < shelves.length; i++) {
    const rows = (shelves[i].contents || [])
      .map(function (item) { return item?.musicResponsiveListItemRenderer || item?.musicTwoColumnItemRenderer; })
      .filter(Boolean);
    if (rows.some(function (row) { return rendererVideoId(row); })) return rows;
  }
  return collect(data, 'musicResponsiveListItemRenderer')
    .concat(collect(data, 'musicTwoColumnItemRenderer'));
}

async function getAlbum(albumId) {
  if (!albumId) throw new Error(LOG + ' Missing albumId');
  const clients = [WEB_CLIENT, SEARCH_CLIENT];
  let chosen = null;
  let rows = [];
  let lastErr = null;
  for (let i = 0; i < clients.length; i++) {
    try {
      const data = await innertube(clients[i], 'browse', { browseId: String(albumId) });
      const candidateRows = albumRows(data);
      if (candidateRows.length) { chosen = data; rows = candidateRows; break; }
      lastErr = new Error(LOG + ' ' + clients[i].name + ': album has no track rows');
    } catch (e) { lastErr = e; }
  }
  if (!chosen) throw (lastErr || new Error(LOG + ' Could not load album'));

  const info = albumHeader(chosen, albumId);
  const fallback = {
    artist: info.artist,
    artistId: info.artistId,
    album: info.title,
    albumId: String(albumId),
    albumCover: info.albumCover,
  };
  const tracks = [];
  const seen = {};
  for (let i = 0; i < rows.length; i++) {
    const track = mapTrackRenderer(rows[i], fallback);
    if (!track || seen[track.id]) continue;
    seen[track.id] = true;
    tracks.push(track);
  }
  if (!tracks.length) throw new Error(LOG + ' Album rows contained no playable track IDs');
  // The current track request will prefetch only the following tracks from
  // this list, avoiding unnecessary player calls for the beginning of an album.
  lastTrackList = tracks;
  return {
    album: {
      id: String(albumId),
      title: info.title,
      artist: info.artist,
      artistId: info.artistId,
      albumCover: info.albumCover || tracks[0].albumCover || '',
    },
    tracks: tracks,
  };
}

// --------------------------------------------------------------------- export
return {
  id: 'ytm-instant',
  name: 'YouTube Music — Instant',
  author: 'nvmind',
  version: '1.4.0',
  labels: ['YT Music', 'Instant', 'Audio', 'Download'],
  description: 'Low-latency YouTube Music. Lean single-call resolve to a player-ready progressive stream — instant playback that actually plays, prefetch-enabled, no third-party resolvers.',

  // googlevideo URLs live ~6h -> prefetch + cache within a session is safe.
  noPrefetch: false,
  noStreamCache: false,

  settings: {
    quality: {
      type: 'selector',
      label: 'Audio Quality',
      description: 'Affects downloads & audio-only fallback.',
      options: QUALITY_OPTIONS,
      defaultValue: QUALITY.HIGH,
    },
  },

  searchTracks: searchTracks,
  getTrackStreamUrl: getTrackStreamUrl,
  getTrackDownloadUrl: getTrackDownloadUrl,
  getAlbum: getAlbum,
};
